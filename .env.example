# Copied into every worktree by .worktreeinclude. Keep this file free of real secrets.

# --- Core ---
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://storylight:storylight@localhost:5432/storylight

# --- AI mode: live | recorded | fake ---
# Only "fake" is safe with no provider keys. Tests and agent worktrees always use fake.
AI_MODE=fake

# --- Provider keys (leave blank in every worktree except the lead's .env.live) ---
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
IMAGE_PROVIDER_API_KEY=

# --- Storage ---
ASSET_STORE=local
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Budget guard ---
DAILY_AI_BUDGET_USD=10

# --- Internal page ---
INTERNAL_BASIC_AUTH_USER=admin
INTERNAL_BASIC_AUTH_PASS=change-me
