{
  "name": "storylight",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter ./apps/* run dev",
    "build": "pnpm --recursive run build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm --recursive run typecheck",
    "test": "pnpm --recursive run test",
    "test:unit": "pnpm --recursive run test:unit",
    "verify:quick": "pnpm run lint && pnpm run typecheck && pnpm run test:unit",
    "format": "prettier --write .",
    "wt:setup": "tsx scripts/wt-setup.ts",
    "generate:fixture-story": "tsx scripts/generate-fixture-story.ts",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.48.2",
    "@storylight/shared": "workspace:*",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.12.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@9.5.0"
}
